{
  "name": "openstream-orgista",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner && node --test server/*.node-test.mjs scripts/*.node-test.mjs",
    "test:watch": "vitest",
    "preview": "vite preview",
    "gateway": "node server/openstream-gateway.mjs",
    "qa": "node scripts/qa.mjs",
    "openpencil:smoke": "node scripts/openpencil-smoke.mjs",
    "make": "node scripts/design-agent.mjs",
    "make:new": "node scripts/design-agent.mjs --new"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.12.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
